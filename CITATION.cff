license: Apache-2.0
doi: 10.5281/zenodo.24484086
repository-code: "https://github.com/lupodevelop/skolem-order6"
keywords:
  - Skolem problem
  - linear recurrence sequences
  - p-adic valuation
  - twisted zeros
  - Lean 4
  - formal verification
